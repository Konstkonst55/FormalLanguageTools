<Application x:Class="FormalLanguageTools.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#3157C8" />
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F3F5F9" />
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#DCE2EC" />
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#667085" />
    </Application.Resources>
</Application>
