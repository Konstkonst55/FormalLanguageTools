<Window x:Class="FormalLanguageTools.App.Views.SyntaxTreeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Дерево разбора"
        Width="560"
        Height="680"
        MinWidth="380"
        MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Background="#F3F5F9">
    <Window.Resources>
        <Style TargetType="TreeViewItem">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="4,3" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="IsExpanded" Value="True" />
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,12">
            <TextBlock Text="Дерево разбора" FontSize="20" FontWeight="SemiBold" Foreground="#182230" />
            <TextBlock x:Name="ExpressionDescription" Margin="0,5,0,0" FontSize="12" Foreground="#667085" TextWrapping="Wrap" />
        </StackPanel>
        <Border Grid.Row="1" BorderBrush="#DCE2EC" BorderThickness="1" CornerRadius="8" Background="White" Padding="8">
            <TreeView x:Name="SyntaxTree" Background="White" BorderThickness="0" />
        </Border>
    </Grid>
</Window>
